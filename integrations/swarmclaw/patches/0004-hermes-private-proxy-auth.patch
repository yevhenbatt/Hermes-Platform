--- a/src/lib/server/hermes-private-auth.ts
+++ b/src/lib/server/hermes-private-auth.ts
@@ -1,5 +1,15 @@
 import { timingSafeEqual } from 'node:crypto'
 
+export const isHermesExecutionRoute = (pathname: string, method: string): boolean => {
+  if (pathname === '/api/internal/hermes/executions' || pathname === '/api/internal/hermes/executions/') {
+    return method === 'POST'
+  }
+
+  const executionPath = /^\/api\/internal\/hermes\/executions\/[^/]+(\/stop)?\/?$/.exec(pathname)
+  if (!executionPath) return false
+  return executionPath[1] ? method === 'POST' : method === 'GET' || method === 'DELETE'
+}
+
 export type HermesServiceAuthorization =
   | { authorized: true }
   | { authorized: false; reason: 'not_configured' | 'invalid_key' }
diff --git a/src/lib/server/hermes-private-proxy.test.ts b/src/lib/server/hermes-private-proxy.test.ts
