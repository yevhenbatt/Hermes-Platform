+++ b/src/lib/server/hermes-private-proxy.test.ts
@@ -0,0 +1,86 @@
+import assert from 'node:assert/strict'
+import { afterEach, test } from 'node:test'
+import { NextRequest } from 'next/server'
+
+import { proxy } from '../../proxy'
+import { isHermesExecutionRoute } from './hermes-private-auth'
+
+const originalServiceKey = process.env.HERMES_SWARMCLAW_SERVICE_KEY
+const originalAccessKey = process.env.ACCESS_KEY
+
+afterEach(() => {
+  if (originalServiceKey === undefined) delete process.env.HERMES_SWARMCLAW_SERVICE_KEY
+  else process.env.HERMES_SWARMCLAW_SERVICE_KEY = originalServiceKey
+  if (originalAccessKey === undefined) delete process.env.ACCESS_KEY
+  else process.env.ACCESS_KEY = originalAccessKey
+})
+
+test('пропускает service key при включённом общем ACCESS_KEY', () => {
+  process.env.ACCESS_KEY = 'dashboard-test-key'
+  process.env.HERMES_SWARMCLAW_SERVICE_KEY = 'service-test-key'
+  const response = proxy(new NextRequest('http://localhost/api/internal/hermes/executions', {
+    method: 'POST',
+    headers: { 'x-hermes-service-key': 'service-test-key' },
+  }))
+  assert.equal(response.status, 200)
+  assert.equal(response.headers.get('x-middleware-next'), '1')
+})
+
+test('отклоняет отсутствующий и неверный service key', () => {
+  process.env.ACCESS_KEY = 'dashboard-test-key'
+  process.env.HERMES_SWARMCLAW_SERVICE_KEY = 'service-test-key'
+  for (const key of ['', 'wrong-key']) {
+    const response = proxy(new NextRequest('http://localhost/api/internal/hermes/executions', {
+      method: 'POST',
+      headers: { 'x-hermes-service-key': key },
+    }))
+    assert.equal(response.status, 401)
+  }
+})
+
+test('общий ключ не заменяет service key', () => {
+  process.env.ACCESS_KEY = 'dashboard-test-key'
+  process.env.HERMES_SWARMCLAW_SERVICE_KEY = 'service-test-key'
+  const response = proxy(new NextRequest('http://localhost/api/internal/hermes/executions', {
+    method: 'POST',
+    headers: { 'x-access-key': 'dashboard-test-key' },
+  }))
+  assert.equal(response.status, 401)
+})
+
+test('без настройки service key маршрут закрыт даже в режиме без ACCESS_KEY', () => {
+  delete process.env.ACCESS_KEY
+  delete process.env.HERMES_SWARMCLAW_SERVICE_KEY
+  const response = proxy(new NextRequest('http://localhost/api/internal/hermes/executions', { method: 'POST' }))
+  assert.equal(response.status, 503)
+})
+
+test('service key не открывает соседние API', () => {
+  process.env.ACCESS_KEY = 'dashboard-test-key'
+  process.env.HERMES_SWARMCLAW_SERVICE_KEY = 'service-test-key'
+  for (const pathname of ['/api/agents', '/api/internal/hermes/executions-admin', '/api/internal/hermes/executions/id/stop/extra']) {
+    const response = proxy(new NextRequest(`http://localhost${pathname}`, {
+      method: 'POST',
+      headers: { 'x-hermes-service-key': 'service-test-key' },
+    }))
+    assert.equal(response.status, 401)
+  }
+})
+
+test('распознаёт только существующие методы и формы execution-маршрутов', () => {
+  for (const [pathname, method] of [
+    ['/api/internal/hermes/executions', 'POST'],
+    ['/api/internal/hermes/executions/', 'POST'],
+    ['/api/internal/hermes/executions/task-123', 'GET'],
+    ['/api/internal/hermes/executions/task-123/', 'DELETE'],
+    ['/api/internal/hermes/executions/task-123/stop', 'POST'],
+  ]) assert.equal(isHermesExecutionRoute(pathname, method), true)
+
+  for (const [pathname, method] of [
+    ['/api/internal/hermes/executions', 'GET'],
+    ['/api/internal/hermes/executions/task-123', 'PATCH'],
+    ['/api/internal/hermes/executions/task-123/stop', 'GET'],
+    ['/api/internal/hermes/executions/task-123/stop/extra', 'POST'],
+    ['/api/internal/hermes/executions-other', 'POST'],
+  ]) assert.equal(isHermesExecutionRoute(pathname, method), false)
+})
