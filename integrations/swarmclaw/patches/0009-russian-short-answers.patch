+test('validateTaskCompletion recognizes Russian short-answer requests', () => {
+  for (const description of ['Ответь одним словом: OK.', 'Напиши одно слово.', 'Ответь одной фразой.', 'Ответь одним предложением.']) {
+    const validation = validateTaskCompletion({ title: 'Hermes task', description, result: 'OK', error: null })
+    assert.equal(validation.ok, true, description)
+  }
+})
+
+test('Russian short-answer requests do not permit empty results or errors', () => {
+  const empty = validateTaskCompletion({ title: 'Hermes task', description: 'Ответь одним словом.', result: '', error: null })
+  const failed = validateTaskCompletion({ title: 'Hermes task', description: 'Ответь одним словом.', result: 'OK', error: 'Provider failed' })
+  assert.equal(empty.ok, false)
+  assert.equal(failed.ok, false)
+})
+
+test('Russian short-answer requests do not bypass explicit quality gates', () => {
+  const validation = validateTaskCompletion({
+    title: 'Hermes task', description: 'Ответь одним словом.', result: 'OK', error: null,
+    qualityGate: { enabled: true, minResultChars: 20, minEvidenceItems: 0 },
+  })
+  assert.equal(validation.ok, false)
+  assert.ok(validation.reasons.some((reason) => reason.includes('Quality gate: result summary is shorter')))
+})
