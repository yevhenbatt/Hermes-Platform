@@ -0,0 +1,24 @@
+import { timingSafeEqual } from 'node:crypto'
+
+export type HermesServiceAuthorization =
+  | { authorized: true }
+  | { authorized: false; reason: 'not_configured' | 'invalid_key' }
+
+export const authorizeHermesServiceRequest = (
+  request: Request,
+  configuredKey = process.env.HERMES_SWARMCLAW_SERVICE_KEY || '',
+): HermesServiceAuthorization => {
+  if (!configuredKey) return { authorized: false, reason: 'not_configured' }
+
+  const receivedKey = request.headers.get('x-hermes-service-key') || ''
+  const expected = Buffer.from(configuredKey)
+  const received = Buffer.from(receivedKey)
+
+  if (expected.length !== received.length) {
+    return { authorized: false, reason: 'invalid_key' }
+  }
+
+  return timingSafeEqual(expected, received)
+    ? { authorized: true }
+    : { authorized: false, reason: 'invalid_key' }
+}
diff --git a/src/lib/server/hermes-provider-profile.ts b/src/lib/server/hermes-provider-profile.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/server/hermes-provider-profile.ts
@@ -0,0 +1,30 @@
+import path from 'node:path'
+
+const HERMES_PROVIDER_CONNECTION_PREFIX = 'hermes-provider:'
+const PROVIDER_CONNECTION_ID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
+
+export const toHermesProviderCredentialId = (providerConnectionId: string): string => {
+  const normalizedId = providerConnectionId.trim().toLowerCase()
+  if (!PROVIDER_CONNECTION_ID_PATTERN.test(normalizedId)) {
+    throw new Error('providerConnectionId must be a UUID')
+  }
+  return `${HERMES_PROVIDER_CONNECTION_PREFIX}${normalizedId}`
+}
+
+export const getHermesProviderConnectionId = (credentialId: string | null | undefined): string | null => {
+  if (typeof credentialId !== 'string') return null
+  const normalizedCredentialId = credentialId.trim().toLowerCase()
+  if (!normalizedCredentialId.startsWith(HERMES_PROVIDER_CONNECTION_PREFIX)) return null
+
+  const providerConnectionId = normalizedCredentialId.slice(HERMES_PROVIDER_CONNECTION_PREFIX.length)
+  return PROVIDER_CONNECTION_ID_PATTERN.test(providerConnectionId) ? providerConnectionId : null
+}
+
+export const resolveCodexOAuthProfileHome = (
+  credentialId: string | null | undefined,
+  profileRoot = process.env.HERMES_OAUTH_PROFILE_ROOT || '/opt/data/hermes-oauth-profiles',
+): string | null => {
+  const providerConnectionId = getHermesProviderConnectionId(credentialId)
+  if (!providerConnectionId) return null
+  return path.join(profileRoot, 'codex', providerConnectionId)
+}
