diff --git a/src/app/api/internal/hermes/executions/route.ts b/src/app/api/internal/hermes/executions/route.ts
new file mode 100644
--- /dev/null
+++ b/src/app/api/internal/hermes/executions/route.ts
@@ -0,0 +1,97 @@
+import { NextResponse } from 'next/server'
+import { z } from 'zod'
+
+import { safeParseBody } from '@/lib/server/safe-parse-body'
+import { getAgent, saveAgent } from '@/lib/server/agents/agent-repository'
+import { authorizeHermesServiceRequest } from '@/lib/server/hermes-private-auth'
+import { toHermesProviderCredentialId } from '@/lib/server/hermes-provider-profile'
+import { createTaskFromRoute } from '@/lib/server/tasks/task-route-service'
+import type { Agent, BoardTask } from '@/types'
+
+const HermesExecutionSchema = z.object({
+  gatewayTaskId: z.string().uuid(),
+  providerConnectionId: z.string().uuid(),
+  organizationId: z.string().uuid(),
+  workspaceId: z.string().uuid().nullable(),
+  projectId: z.string().uuid().nullable(),
+  userId: z.string().uuid(),
+  title: z.string().trim().min(1).max(120).default('Hermes Workspace task'),
+  input: z.string().trim().min(1).max(20_000),
+  instructions: z.string().trim().max(20_000).default(''),
+}).strict()
+
+const toExecutionResponse = (task: BoardTask) => NextResponse.json({
+  executionId: task.id,
+  status: task.status,
+  output: typeof task.result === 'string' ? task.result : null,
+  error: typeof task.error === 'string' ? task.error : null,
+})
+
+const getHermesCodexAgentId = (providerConnectionId: string): string => (
+  `hermes-gateway-codex-${providerConnectionId}`
+)
+
+const ensureHermesCodexAgent = (providerConnectionId: string): Agent => {
+  const id = getHermesCodexAgentId(providerConnectionId)
+  const existing = getAgent(id)
+  if (existing) return existing
+
+  const now = Date.now()
+  const agent: Agent = {
+    id,
+    name: `Hermes Codex ${providerConnectionId.slice(0, 8)}`,
+    description: 'Технический агент Hermes Workspace для изолированного подключения Codex.',
+    systemPrompt: 'Выполняй только задачу, переданную Hermes Workspace Gateway.',
+    provider: 'codex-cli',
+    model: 'gpt-5.4-codex',
+    credentialId: toHermesProviderCredentialId(providerConnectionId),
+    fallbackCredentialIds: [],
+    heartbeatEnabled: false,
+    disabled: false,
+    createdAt: now,
+    updatedAt: now,
+  }
+  saveAgent(id, agent)
+  return agent
+}
+
+const authorize = (request: Request): NextResponse | null => {
+  const authorization = authorizeHermesServiceRequest(request)
+  if (authorization.authorized) return null
+  return NextResponse.json(
+    { error: authorization.reason === 'not_configured' ? 'Hermes private API is unavailable' : 'Unauthorized' },
+    { status: authorization.reason === 'not_configured' ? 503 : 401 },
+  )
+}
+
+export const POST = async (request: Request) => {
+  const unauthorized = authorize(request)
+  if (unauthorized) return unauthorized
+
+  const { data, error } = await safeParseBody<Record<string, unknown>>(request)
+  if (error) return error
+  const parsed = HermesExecutionSchema.safeParse(data)
+  if (!parsed.success) {
+    return NextResponse.json({ error: 'Invalid Hermes execution request' }, { status: 400 })
+  }
+
+  const agent = ensureHermesCodexAgent(parsed.data.providerConnectionId)
+  const result = createTaskFromRoute({
+    title: parsed.data.title,
+    description: `${parsed.data.instructions}\n\n${parsed.data.input}`.trim(),
+    status: 'queued',
+    agentId: agent.id,
+    customFields: {
+      hermesGatewayTaskId: parsed.data.gatewayTaskId,
+      hermesProviderConnectionId: parsed.data.providerConnectionId,
+      hermesOrganizationId: parsed.data.organizationId,
+      hermesWorkspaceId: parsed.data.workspaceId,
+      hermesProjectId: parsed.data.projectId,
+      hermesUserId: parsed.data.userId,
+    },
+  })
+
+  return result.ok
+    ? toExecutionResponse(result.payload)
+    : NextResponse.json({ error: result.payload }, { status: result.status })
+}
diff --git a/src/app/api/internal/hermes/executions/[id]/route.ts b/src/app/api/internal/hermes/executions/[id]/route.ts
new file mode 100644
