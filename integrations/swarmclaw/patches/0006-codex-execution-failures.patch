diff --git a/src/lib/providers/codex-execution-policy.test.ts b/src/lib/providers/codex-execution-policy.test.ts
new file mode 100644
index 0000000..4202777
--- /dev/null
+++ b/src/lib/providers/codex-execution-policy.test.ts
@@ -0,0 +1,52 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import {
+  getCodexCloseError,
+  guardExecutionCompletion,
+  HERMES_CODEX_DEFAULT_MODEL,
+  readCodexEventError,
+  redactCodexDiagnostic,
+  resolveCodexModelOverride,
+} from './codex-execution-policy'
+
+test('uses the CLI default only for the Hermes default marker', () => {
+  assert.equal(resolveCodexModelOverride(HERMES_CODEX_DEFAULT_MODEL, true), null)
+  assert.equal(resolveCodexModelOverride('gpt-5.4-codex', true), 'gpt-5.4-codex')
+  assert.equal(resolveCodexModelOverride('user-selected-model', true), 'user-selected-model')
+  assert.equal(resolveCodexModelOverride(null, false), null)
+})
+
+test('extracts structured Codex provider errors', () => {
+  assert.equal(readCodexEventError({ type: 'error', error: { message: 'Model is not supported' } }), 'Model is not supported')
+  assert.equal(readCodexEventError({ type: 'turn.failed', error: { message: 'Auth expired' } }), 'Auth expired')
+  assert.equal(readCodexEventError({ type: 'error', message: JSON.stringify({ error: { message: 'Unsupported model' } }) }), 'Unsupported model')
+  assert.equal(readCodexEventError({ type: 'turn.completed' }), null)
+})
+
+test('rejects nonzero exits, signals, and provider errors even with exit code zero', () => {
+  assert.match(getCodexCloseError(1, null, null, '') ?? '', /code 1/)
+  assert.match(getCodexCloseError(null, 'SIGTERM', null, '') ?? '', /SIGTERM/)
+  assert.equal(getCodexCloseError(1, null, 'Model is not supported', ''), 'Model is not supported')
+  assert.equal(getCodexCloseError(0, null, 'Provider failed', ''), 'Provider failed')
+  assert.equal(getCodexCloseError(0, null, null, 'warning'), null)
+})
+
+test('never validates an errored run as completed', () => {
+  const original = { ok: true, reasons: [], checkedAt: 123 }
+  const result = guardExecutionCompletion(original, 'Provider rejected model')
+  assert.equal(result.ok, false)
+  assert.deepEqual(result.reasons, ['Provider rejected model'])
+  assert.equal(original.ok, true)
+  assert.equal(guardExecutionCompletion(original, null), original)
+})
+
+test('redacts configured secrets and structured OAuth tokens from diagnostics', () => {
+  const result = redactCodexDiagnostic(
+    'key=service-secret Bearer abc.def.token {"refresh_token":"refresh-value"}',
+    { HERMES_SWARMCLAW_SERVICE_KEY: 'service-secret' },
+  )
+  assert.equal(result.includes('service-secret'), false)
+  assert.equal(result.includes('abc.def.token'), false)
+  assert.equal(result.includes('refresh-value'), false)
+  assert.equal(result.includes('[REDACTED]'), true)
+})
diff --git a/src/lib/providers/codex-execution-policy.ts b/src/lib/providers/codex-execution-policy.ts
new file mode 100644
index 0000000..e0cba0d
--- /dev/null
+++ b/src/lib/providers/codex-execution-policy.ts
@@ -0,0 +1,68 @@
+export const HERMES_CODEX_DEFAULT_MODEL = 'hermes-cli-default'
+
+export const resolveCodexModelOverride = (model: unknown, hermesProfile: boolean): string | null => {
+  if (typeof model !== 'string' || !model.trim()) return null
+  if (hermesProfile && model === HERMES_CODEX_DEFAULT_MODEL) return null
+  return model.trim()
+}
+
+export const readCodexEventError = (event: unknown): string | null => {
+  if (!event || typeof event !== 'object') return null
+  const value = event as Record<string, unknown>
+  if (value.type !== 'error' && value.type !== 'turn.failed') return null
+  const nested = value.error && typeof value.error === 'object'
+    ? (value.error as Record<string, unknown>).message
+    : null
+  const message = typeof nested === 'string' ? nested : value.message
+  if (typeof message !== 'string' || !message.trim()) return 'Codex reported an execution error'
+  try {
+    const parsed: unknown = JSON.parse(message)
+    if (parsed && typeof parsed === 'object') {
+      const inner = (parsed as Record<string, unknown>).error
+      if (inner && typeof inner === 'object' && typeof (inner as Record<string, unknown>).message === 'string') {
+        return String((inner as Record<string, unknown>).message).slice(0, 1200)
+      }
+    }
+  } catch { /* Plain-text provider errors do not need JSON parsing. */ }
+  return message.trim().slice(0, 1200)
+}
+
+export const getCodexCloseError = (
+  code: number | null,
+  signal: string | null,
+  providerError: string | null,
+  stderr: string,
+): string | null => {
+  if (providerError) return providerError
+  if (code === 0 && !signal) return null
+  return `Codex CLI exited with code ${code ?? 'unknown'}${signal ? ` (${signal})` : ''}${stderr.trim() ? `: ${stderr.trim().slice(0, 1200)}` : ' and returned no output.'}`
+}
+
+interface CompletionValidation {
+  ok: boolean
+  reasons: string[]
+  checkedAt: number
+}
+
+export const guardExecutionCompletion = (
+  validation: CompletionValidation,
+  runError: string | null | undefined,
+): CompletionValidation => {
+  if (!runError?.trim()) return validation
+  return { ...validation, ok: false, reasons: [runError.trim(), ...validation.reasons] }
+}
+
+export const redactCodexDiagnostic = (
+  text: string,
+  environment: Record<string, string | undefined> = process.env,
+): string => {
+  let result = text
+  for (const [name, value] of Object.entries(environment)) {
+    if (value && value.length >= 4 && /KEY|TOKEN|SECRET|PASSWORD|COOKIE|AUTH/i.test(name)) {
+      result = result.split(value).join('[REDACTED]')
+    }
+  }
+  return result
+    .replace(/\bBearer\s+[A-Za-z0-9._~+\/-]+=*/gi, 'Bearer [REDACTED]')
+    .replace(/("?(?:access_token|refresh_token|id_token|api_key|authorization|cookie)"?\s*[:=]\s*")[^"]*"/gi, '$1[REDACTED]"')
+}
