diff --git a/src/lib/server/hermes-private-auth.test.ts b/src/lib/server/hermes-private-auth.test.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/server/hermes-private-auth.test.ts
@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+
+import { authorizeHermesServiceRequest } from './hermes-private-auth'
+
+test('accepts a matching Hermes service key', () => {
+  const request = new Request('http://localhost', {
+    headers: { 'x-hermes-service-key': 'private-key' },
+  })
+  assert.deepEqual(authorizeHermesServiceRequest(request, 'private-key'), { authorized: true })
+})
+
+test('rejects a missing or mismatched Hermes service key', () => {
+  const request = new Request('http://localhost')
+  assert.deepEqual(authorizeHermesServiceRequest(request, 'private-key'), {
+    authorized: false,
+    reason: 'invalid_key',
+  })
+  assert.deepEqual(authorizeHermesServiceRequest(request, ''), {
+    authorized: false,
+    reason: 'not_configured',
+  })
+})
diff --git a/src/lib/server/hermes-provider-profile.test.ts b/src/lib/server/hermes-provider-profile.test.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/server/hermes-provider-profile.test.ts
@@ -0,0 +1,25 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+
+import {
+  getHermesProviderConnectionId,
+  resolveCodexOAuthProfileHome,
+  toHermesProviderCredentialId,
+} from './hermes-provider-profile'
+
+const connectionId = '11111111-2222-3333-4444-555555555555'
+
+test('creates an isolated Codex profile from a provider connection', () => {
+  const credentialId = toHermesProviderCredentialId(connectionId)
+  assert.equal(getHermesProviderConnectionId(credentialId), connectionId)
+  assert.equal(
+    resolveCodexOAuthProfileHome(credentialId, '/profiles'),
+    '/profiles/codex/11111111-2222-3333-4444-555555555555',
+  )
+})
+
+test('refuses non-UUID and foreign credential identifiers', () => {
+  assert.throws(() => toHermesProviderCredentialId('../outside'))
+  assert.equal(getHermesProviderConnectionId('cred-user-key'), null)
+  assert.equal(resolveCodexOAuthProfileHome('hermes-provider:../outside', '/profiles'), null)
+})
