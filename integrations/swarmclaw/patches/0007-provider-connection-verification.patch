@@ -0,0 +1,56 @@
+import assert from 'node:assert/strict'
+import { afterEach, beforeEach, test } from 'node:test'
+import { randomUUID } from 'node:crypto'
+import os from 'node:os'
+import path from 'node:path'
+import { POST } from '../../app/api/internal/hermes/provider-connections/[id]/verify/route'
+
+const connectionId = '6a5fb5be-ebaf-4aa9-af04-645b335510e6'
+const previousKey = process.env.HERMES_SWARMCLAW_SERVICE_KEY
+const previousRoot = process.env.HERMES_OAUTH_PROFILE_ROOT
+const context = () => ({ params: Promise.resolve({ id: connectionId }) })
+
+beforeEach(() => {
+  process.env.HERMES_SWARMCLAW_SERVICE_KEY = 'verification-test-key'
+  process.env.HERMES_OAUTH_PROFILE_ROOT = path.join(os.tmpdir(), `hermes-missing-profile-${randomUUID()}`)
+})
+
+afterEach(() => {
+  if (previousKey === undefined) delete process.env.HERMES_SWARMCLAW_SERVICE_KEY
+  else process.env.HERMES_SWARMCLAW_SERVICE_KEY = previousKey
+  if (previousRoot === undefined) delete process.env.HERMES_OAUTH_PROFILE_ROOT
+  else process.env.HERMES_OAUTH_PROFILE_ROOT = previousRoot
+})
+
+test('rejects missing or incorrect service credentials before verification', async () => {
+  for (const key of ['', 'wrong-key']) {
+    const response = await POST(new Request('http://localhost/verify', {
+      method: 'POST', headers: { 'x-hermes-service-key': key },
+    }), context())
+    assert.equal(response.status, 401)
+  }
+})
+
+test('fails closed when the private service key is not configured', async () => {
+  delete process.env.HERMES_SWARMCLAW_SERVICE_KEY
+  const response = await POST(new Request('http://localhost/verify', { method: 'POST' }), context())
+  assert.equal(response.status, 503)
+})
+
+test('rejects an invalid profile identifier', async () => {
+  const response = await POST(new Request('http://localhost/verify', {
+    method: 'POST', headers: { 'x-hermes-service-key': 'verification-test-key' },
+  }), { params: Promise.resolve({ id: '../another-profile' }) })
+  assert.equal(response.status, 400)
+})
+
+test('ignores caller authentication claims and returns only verified metadata', async () => {
+  const response = await POST(new Request('http://localhost/verify', {
+    method: 'POST', headers: { 'x-hermes-service-key': 'verification-test-key' },
+    body: JSON.stringify({ authenticated: true, profileHome: '/some/other/profile', status: 'active' }),
+  }), context())
+  assert.equal(response.status, 200)
+  assert.deepEqual(await response.json(), {
+    providerConnectionId: connectionId, provider: 'codex', authenticated: false, method: 'codex_login_status',
+  })
+})
diff --git a/src/lib/server/hermes-provider-verification.test.ts b/src/lib/server/hermes-provider-verification.test.ts
