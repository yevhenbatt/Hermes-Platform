+import { NextResponse } from 'next/server'
+import { authorizeHermesServiceRequest } from '@/lib/server/hermes-private-auth'
+import { toHermesProviderCredentialId } from '@/lib/server/hermes-provider-profile'
+import { verifyCodexProviderConnection } from '@/lib/server/hermes-provider-verification'
+
+export const POST = async (request: Request, context: { params: Promise<{ id: string }> }) => {
+  const authorization = authorizeHermesServiceRequest(request)
+  if (!authorization.authorized) {
+    return NextResponse.json(
+      { error: authorization.reason === 'not_configured' ? 'Hermes private API is unavailable' : 'Unauthorized' },
+      { status: authorization.reason === 'not_configured' ? 503 : 401 },
+    )
+  }
+  const { id } = await context.params
+  try {
+    toHermesProviderCredentialId(id)
+  } catch {
+    return NextResponse.json({ error: 'Invalid provider connection ID' }, { status: 400 })
+  }
+  try {
+    return NextResponse.json(await verifyCodexProviderConnection(id))
+  } catch {
+    return NextResponse.json({ error: 'Provider verification is unavailable' }, { status: 503 })
+  }
+}
